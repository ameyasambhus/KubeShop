# ==============================================================================
# KubeShop Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local bare-metal or container development:
#   cp .env.example .env
#
# NOTE: Do NOT store sensitive production credentials in this file.
# In Kubernetes, non-sensitive variables are injected via ConfigMap,
# and secrets are injected via Kubernetes Secret objects.
# ==============================================================================

# Global Environment (development | test | production)
APP_ENV=development
LOG_LEVEL=INFO

# ------------------------------------------------------------------------------
# API Gateway Configuration
# ------------------------------------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_HOST=0.0.0.0
# Downstream URLs: In local development, use localhost with distinct ports.
# In Docker Compose, use http://product-service:8001 and http://order-service:8002
# In Kubernetes, use http://product-service:8000 and http://order-service:8000
PRODUCT_SERVICE_URL=http://localhost:8001
ORDER_SERVICE_URL=http://localhost:8002
GATEWAY_REQUEST_TIMEOUT_SECONDS=5.0

# ------------------------------------------------------------------------------
# Product Service Configuration
# ------------------------------------------------------------------------------
PRODUCT_SERVICE_PORT=8001
PRODUCT_SERVICE_HOST=0.0.0.0
# Async PostgreSQL DSN: postgresql+asyncpg://<user>:<password>@<host>:<port>/<dbname>
# For local unit tests, sqlite+aiosqlite:///:memory: is supported
PRODUCT_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kubeshop_product

# Fault Simulation & Latency (Disabled by default: 0 ms)
# Used in failure scenario experiments (e.g. testing downstream timeouts)
SIMULATED_LATENCY_MS=0
SIMULATED_FAILURE_RATE=0.0

# ------------------------------------------------------------------------------
# Order Service Configuration
# ------------------------------------------------------------------------------
ORDER_SERVICE_PORT=8002
ORDER_SERVICE_HOST=0.0.0.0
ORDER_DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/kubeshop_order
# Order service calls product service to validate catalog and inventory
ORDER_TO_PRODUCT_TIMEOUT_SECONDS=2.5

# ------------------------------------------------------------------------------
# Frontend Configuration
# ------------------------------------------------------------------------------
FRONTEND_PORT=3000
# Target API Gateway URL for browser requests (via Vite dev server proxy or Nginx)
VITE_API_GATEWAY_URL=http://localhost:8000

# ------------------------------------------------------------------------------
# PostgreSQL Container Setup (for Docker Compose / Local Postgres)
# ------------------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432
